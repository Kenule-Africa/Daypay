-- Apply as owner after migration 202611251301, with the dedicated worker login
-- supplied as a psql identifier variable, as for the verification worker grants.
-- The worker gains only the four reset-email delivery operations (IMP-P3-008).
GRANT CONNECT ON DATABASE :"DBNAME" TO :"worker_role";
GRANT USAGE ON SCHEMA integrations TO :"worker_role";
GRANT EXECUTE ON FUNCTION integrations.dispatch_password_reset_email(integer),
    integrations.claim_password_reset_email(text,integer,integer),
    integrations.prepare_password_reset_email(uuid,uuid,text,text),
    integrations.finish_password_reset_email(uuid,uuid,text,bigint,uuid) TO :"worker_role";
