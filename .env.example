# Copy to .env for Compose. Inject API and worker environment separately.
APP_ENV=local
API_BIND_ADDR=127.0.0.1:8000
API_BASE_URL=http://127.0.0.1:8000
DB_MAX_CONNECTIONS=5
LOG_LEVEL=info

# Set two different local-only passwords. Use the encoded app password in DATABASE_URL.
POSTGRES_PASSWORD=
DEYPAY_DB_PASSWORD=
DATABASE_URL=
